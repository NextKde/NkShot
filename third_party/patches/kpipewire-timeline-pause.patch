+        // A sample interval must have finished before we decide whether to keep
+        // it. Future tails stay owned here, and are classified after the clock
+        // reaches them, including pause/resume commands received meanwhile.
+        const auto elapsed = std::chrono::duration<double>(now - pending.begin).count();
+        const size_t available = size_t(std::clamp<int64_t>(int64_t(std::floor(elapsed * pending.rate)), 0, count));
+        size_t i = pending.consumed;
+        while (i < available) {
+            const auto stamp = pending.begin + samplesToDuration(i, pending.rate);
+            if (stamp < epoch || pausedAt(stamp) || m_audioInputStates[pending.input].ended) {
+                ++i;
