+std::chrono::nanoseconds PipeWireProduce::activeTime(Clock::time_point when)
+{
+    const auto epoch = recordEpoch();
+    if (when <= epoch) {
+        return std::chrono::nanoseconds::zero();
+    }
+    auto result = std::chrono::duration_cast<std::chrono::nanoseconds>(when - epoch);
+    for (const auto &interval : m_pauseIntervals) {
+        const auto begin = std::max(epoch, interval.begin);
+        const auto end = std::min(when, interval.end.value_or(when));
+        if (end > begin) {
+            result -= end - begin;
+        }
+    }
+    return result;
+}
+
+bool PipeWireProduce::pausedAt(Clock::time_point when) const
+{
+    for (const auto &interval : m_pauseIntervals) {
+        if (when >= interval.begin && (!interval.end || when < *interval.end)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool PipeWireProduce::acceptsVideoTimestamp(const std::optional<std::chrono::nanoseconds> &timestamp) const
+{
+    if (m_deactivated || m_timelinePaused || !timestamp) {
+        return false;
+    }
+    const auto when = timePoint(*timestamp);
+    if (when > monotonicNow()) {
+        return false;
+    }
+    // A pre-epoch static initial frame is legal. After resume, however, an old
+    // rendered timestamp is not evidence of fresh screen content. Do not rebase
+    // or replay such buffers: retain the previously encoded picture until fresh
+    // content arrives. This intentionally favours privacy over static refresh.
+    return !pausedAt(when) && (m_pauseIntervals.empty() ||
+        (m_pauseIntervals.back().end && when >= *m_pauseIntervals.back().end));
+}
