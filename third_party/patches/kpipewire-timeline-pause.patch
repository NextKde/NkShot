+        if (!m_pendingAudioTimer) {
+            m_pendingAudioTimer = std::make_unique<QTimer>();
+            m_pendingAudioTimer->setSingleShot(true);
+            connect(m_pendingAudioTimer.get(), &QTimer::timeout, this, &PipeWireProduce::drainPendingAudio);
+        }
